{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "node_modules/**",
      "assets/copys/**",
      "**/*.psd",
      "assets/fonts/Ninna/**",
      "assets/fonts/Roobert/**",
      "assets/fonts/*.otf",
      "README.md",
      "COPY-ESTRUTURA.md",
      "COPY-ATUAL.md",
      "ESTRUTURA-TEXTO.md",
      "AGENTS.md"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|webp|svg|gif)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
